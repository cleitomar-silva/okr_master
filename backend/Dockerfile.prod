# CA raiz do FortiGate (inspecao SSL da rede corporativa) para o composer.
# Inofensivo em redes sem proxy; necessario onde o FortiGate intercepta TLS.
FROM composer:2 AS vendor
WORKDIR /tmp
COPY . .
COPY docker/ca/fortinet-ca.crt /certs/fortinet-ca.crt
ENV COMPOSER_CAFILE=/certs/fortinet-ca.crt
RUN composer install --no-interaction --no-dev --prefer-dist --optimize-autoloader --classmap-authoritative --ignore-platform-reqs --no-scripts

FROM php:8.3-fpm

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor libzip-dev libicu-dev libonig-dev \
    && docker-php-ext-install pdo_mysql mbstring zip intl pcntl \
    && printf 'upload_max_filesize=50M\npost_max_size=64M\nmemory_limit=256M\nopcache.enable=1\nopcache.enable_cli=0\nopcache.memory_consumption=128\nopcache.max_accelerated_files=10000\nopcache.validate_timestamps=0\n' > /usr/local/etc/php/conf.d/production.ini \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .
COPY --from=vendor /tmp/vendor ./vendor
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/supervisord.conf /etc/supervisor/supervisord.conf
COPY docker/start.sh /usr/local/bin/start

RUN cat docker/ca/fortinet-ca.crt >> /etc/ssl/certs/ca-certificates.crt \
    && chmod +x /usr/local/bin/start \
    && mkdir -p storage/logs storage/framework/cache/data storage/framework/sessions storage/framework/views \
    && chown -R www-data:www-data storage bootstrap/cache

RUN chmod +x /usr/local/bin/start \
    && mkdir -p storage/logs storage/framework/cache/data storage/framework/sessions storage/framework/views \
    && chown -R www-data:www-data storage bootstrap/cache

EXPOSE 9192
CMD ["/usr/local/bin/start"]